{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "prebuild": "npx expo prebuild --clean",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:build": "expo export --platform web",
    "test": "TZ=UTC jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --project tsconfig.json",
    "build:e2e:android": "EXPO_NO_GIT_STATUS=1 EXPO_PUBLIC_E2E=true APP_ENV=dev expo prebuild --platform android --no-install && EXPO_PUBLIC_E2E=true APP_ENV=dev expo run:android --variant release --no-bundler",
    "build:e2e:ios": "EXPO_NO_GIT_STATUS=1 EXPO_PUBLIC_E2E=true APP_ENV=dev expo prebuild --platform ios --no-install && EXPO_PUBLIC_E2E=true APP_ENV=dev expo run:ios --configuration Release --no-bundler",
    "build:e2e:debug": "APP_ENV=dev expo run:android --no-bundler",
    "start:e2e": "APP_ENV=dev EXPO_PUBLIC_E2E=true expo start --localhost --port 8081 --clear"
  },
  "dependencies": {
    "@animavita/types": "workspace:*",
    "@animavita/validation-schemas": "workspace:*",
    "@expo/metro-runtime": "~57.0.18",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^3.10.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/native": "^6.0.13",
    "@react-navigation/native-stack": "^6.9.1",
    "@tanstack/react-query": "^5.52.0",
    "axios": "1.2.0-alpha.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "expo": "^57.0.32",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.23",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.21",
    "expo-linear-gradient": "~57.0.2",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.27",
    "i18next": "^23.2.10",
    "msw": "^2.7.0",
    "native-base": "^3.4.25",
    "normalize-css-color": "^1.0.2",
    "posthog-react-native": "^4.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.42.1",
    "react-i18next": "^12.0.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-international-phone-number": "^0.11.4",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-size-matters": "^0.4.0",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "^3.5.1",
    "react-native-vector-icons": "^9.2.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.10.1",
    "styled-components": "^5.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@testing-library/react-native": "^13.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.18",
    "@types/react-native-vector-icons": "^6.4.13",
    "@types/styled-components": "^5.1.26",
    "@types/styled-components-react-native": "^5.2.0",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-config-universe": "^11.1.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.6",
    "prettier": "^2.3.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}"
    ],
    "setupFiles": [
      "../../node_modules/react-native-gesture-handler/jestSetup.js"
    ],
    "setupFilesAfterEnv": [
      "./jest-setup.js"
    ]
  },
  "eslintConfig": {
    "extends": [
      "universe/native",
      "prettier"
    ],
    "plugins": [
      "prettier",
      "prefer-arrow"
    ],
    "rules": {
      "prettier/prettier": "error",
      "prefer-arrow/prefer-arrow-functions": [
        "warn",
        {
          "disallowPrototype": true,
          "singleReturnOnly": false,
          "classPropertiesAllowed": false
        }
      ]
    }
  }
}
