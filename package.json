  "main": "index.js",
  "scripts": {
    "backend": "pnpm --filter backend",
    "mobile": "pnpm --filter mobile",
    "test": "pnpm backend test && pnpm mobile test",
    "lint": "pnpm backend lint && pnpm mobile lint",
    "check-types": "pnpm backend check-types && pnpm mobile check-types",
