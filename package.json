  },
  "pnpm": {
    "patchedDependencies": {
      "native-base@3.4.25": "patches/native-base@3.4.25.patch"
    },
    "allowNonAppliedPatches": true,
    "overrides": {
      "@aws-sdk/client-s3": "^3.966.0"
